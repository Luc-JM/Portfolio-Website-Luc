# VITE_GEMINI_API_KEY: Required for local Gemini AI API calls.
# Copy this file to .env.local and replace the placeholder with your own key.
VITE_GEMINI_API_KEY=""

# Supabase configuration for persistent portfolio chat history.
VITE_SUPABASE_URL="https://wllvfqseygzflhxjcbxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
